{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "JourneyMatch backend dependencies",
			"type": "shell",
			"command": "python",
			"args": ["-m", "pip", "install", "-r", "requirements.txt"],
			"options": {"cwd": "${workspaceFolder}/backend"},
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "JourneyMatch backend tests",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"pytest"
			],
			"options": {"cwd": "${workspaceFolder}/backend"},
			"isBackground": false,
			"problemMatcher": [],
			"group": "test",
			"dependsOn": "JourneyMatch backend dependencies"
		},
		{
			"label": "JourneyMatch frontend dependencies",
			"type": "shell",
			"command": "npm",
			"args": ["install"],
			"options": {"cwd": "${workspaceFolder}/frontend"},
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "JourneyMatch frontend build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"options": {"cwd": "${workspaceFolder}/frontend"},
			"isBackground": false,
			"problemMatcher": [],
			"group": "build",
			"dependsOn": "JourneyMatch frontend dependencies"
		}
	]
}